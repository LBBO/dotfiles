{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "cmd=$(jq -r '.tool_input.command // empty'); if printf '%s' \"$cmd\" | grep -qE '(^|[[:space:];&|(])(npm|npx)([[:space:];&|)]|$)'; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Do not use npm or npx. Use pnpm instead of npm, and pnpx instead of npx.\"}}'; fi",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block-global-tmp.sh",
            "statusMessage": "Checking for global tmp access",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|Read|NotebookEdit|Glob|Grep|Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block-git-writes.sh",
            "statusMessage": "Checking git write guard",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.js"
  },
  "enabledPlugins": {
    "nono@always-further": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "plansDirectory": "./plans",
  "autoMemoryDirectory": "./memory",
  "theme": "dark"
}
